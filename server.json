{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.AshMet/vibemap-mcp",
  "description": "Load & create VibeMap product specs from your coding agent; sync build progress.",
  "repository": {
    "url": "https://github.com/AshMet/vibemap-mcp",
    "source": "github"
  },
  "version": "2.10.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@vibemap.ai/mcp-server",
      "version": "2.10.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VIBEMAP_API_KEY",
          "description": "API key from vibemap.ai -> Account -> Developer (Pro plan or higher)",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "VIBEMAP_BASE_URL",
          "description": "Defaults to https://vibemap.ai",
          "isRequired": false
        }
      ]
    }
  ]
}
